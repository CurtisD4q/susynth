-- pro.syn: functions, effects, new voices. Evaluate each block with ^E.

bpm 128
delaytime 0.75
delayfb 0.5
roomsize 0.8
d1 "bd*4" # gain 1
d2 $ every 4 (fast 2) $ s "~ cp ~ cp" # room 0.25
d3 $ degradeBy 0.2 $ s "hh*8" # hpf 6000 # gain 0.5 # delay 0.2

d4 $ every 3 rev $ s "<c2 eb2> ~ [c2 g2] ~" # voice supersaw # lpf 700 # gain 0.7
d5 $ iter 4 $ s "c4 e4 g4 b4" # voice fm # delay 0.4 # room 0.3 # rel 0.3
d6 $ palindrome $ s "c3 e3 g3 c4" # voice organ # gain 0.4 # crush 10
